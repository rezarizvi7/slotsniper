# Copy this file to ".env" (same folder) and fill in what you want to use.
# Leave a line blank to turn that feature off. Never share or upload your .env file.

# Telegram alerts: make a bot with @BotFather, then see the README for your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord alerts: Channel settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Optional: lets slotsniper "look" at pages with AI when it can't read them normally
ANTHROPIC_API_KEY=
